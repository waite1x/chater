<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chater.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Chater.Views.Settings.ToolSettingsView"
             x:DataType="vm:ToolSettingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Localization[ToolSettings]}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[ToolSettingsDescription]}" Opacity="0.7"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding AppState.Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.55"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding Localization[ToolSettingsSaved]}" Opacity="0.7"/>
    </Grid>
</UserControl>
