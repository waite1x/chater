<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chater.ViewModels"
             xmlns:local="using:Chater.Views"
             x:Class="Chater.Views.ConversationMessagesView"
             Loaded="OnLoaded">
    <ScrollViewer x:Name="MessagesScrollViewer" ScrollChanged="OnMessagesScrollChanged">
        <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:ConversationMessagesView}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid>
                        <Border Classes="chat-bubble chat-bubble-user"
                                IsVisible="{Binding IsUser}"
                                HorizontalAlignment="Right"
                                Margin="48,0,0,10" Padding="12,9"
                                MaxWidth="520">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                                <local:MarkdownView Markdown="{Binding Content}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="chat-bubble chat-bubble-assistant"
                                IsVisible="{Binding IsAssistant}"
                                HorizontalAlignment="Left"
                                Margin="0,0,48,10" Padding="12,9"
                                MaxWidth="520">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold"/>
                                <local:MarkdownView Markdown="{Binding Content}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
