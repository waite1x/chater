<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chater.ViewModels"
             xmlns:local="using:Chater.Views"
             xmlns:conversations="clr-namespace:Chater.AI.Conversations"
             x:Class="Chater.Views.ConversationMessagesView"
             Loaded="OnLoaded">
    <ScrollViewer x:Name="MessagesScrollViewer" ScrollChanged="OnMessagesScrollChanged">
        <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:ConversationMessagesView}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid>
                        <Border Classes="chat-bubble chat-bubble-user"
                                IsVisible="{Binding IsUser}"
                                HorizontalAlignment="Right"
                                Margin="48,0,0,10" Padding="12,9"
                                MaxWidth="520">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnCopySelectedText"/>
                                    <MenuItem Click="OnCopyMarkdown"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Attachments}"
                                              IsVisible="{Binding HasAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="conversations:MessageAttachment">
                                            <Border CornerRadius="6" Margin="0,0,6,0"
                                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                                <Image Source="{Binding FilePath, Converter={x:Static local:ImagePathToBitmapConverter.Instance}}"
                                                       Width="96" Height="96" Stretch="Uniform"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <local:MarkdownView Markdown="{Binding Content}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="chat-bubble chat-bubble-assistant"
                                IsVisible="{Binding IsAssistant}"
                                HorizontalAlignment="Left"
                                Margin="0,0,48,10" Padding="12,9"
                                MaxWidth="520">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnCopySelectedText"/>
                                    <MenuItem Click="OnCopyMarkdown"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <local:MarkdownView Markdown="{Binding Content}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
