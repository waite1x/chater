<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Chater.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/chater-tray.png"
                      mac:MacOSProperties.IsTemplateIcon="True">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Click="OnTrayShowChat"/>
                        <NativeMenuItem Click="OnTrayShowSettings"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Click="OnTrayExit"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme>
                <FluentTheme.Palettes>
                    <fluent:ColorPaletteResources x:Key="Light" Accent="#0EA5E9" RegionColor="#FFFFFF"/>
                    <fluent:ColorPaletteResources x:Key="Dark"
                                              Accent="#0EA5E9"
                                              RegionColor="#000000"
                                              BaseLow="#000000"
                                              AltLow="#000000"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <Style Selector="Button.window-action-button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-action-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.window-action-button.close-button:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.chat-bubble">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Border.chat-bubble-user">
            <Setter Property="Background" Value="{DynamicResource SecondaryCardBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style Selector="Border.chat-bubble-assistant">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- GitHub Markdown palette. LiveMarkdown resolves these resources dynamically. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ForegroundColor">#1F2328</Color>
                    <Color x:Key="BorderColor">#D0D7DE</Color>
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#F6F8FA</Color>
                    <Color x:Key="CodeInlineColor">#CF222E</Color>
                    <Color x:Key="QuoteBorderColor">#D0D7DE</Color>
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ForegroundColor">#F0F6FC</Color>
                    <Color x:Key="BorderColor">#3D444D</Color>
                    <Color x:Key="CardBackgroundColor">#000000</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#111111</Color>
                    <Color x:Key="CodeInlineColor">#FF7B72</Color>
                    <Color x:Key="QuoteBorderColor">#3D444D</Color>
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
